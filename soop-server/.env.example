# Copy to .env.local. Never commit real keys or paste them into chat.
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=
# Must match the exact SOOP Developers Redirect URL (including trailing slash).
# Local test: temporarily register http://127.0.0.1:4174/ in Developers.
# Production: use HTTPS and point the game domain to this server.
APP_ORIGIN=http://127.0.0.1:4174
PORT=4174
HOST=127.0.0.1
